# Copy to .env and fill in. Never commit real secrets.
# Server-only secrets for local development can go in .env.local (git-ignored);
# in production they are set as Cloudflare Worker secrets.

# --- Public (safe in the browser; baked in at build time) ---------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# SECRET. Full database access; server only.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used in links sent to customers.
REPARA_SITE_URL=https://reparaus.com

# --- AI (see src/lib/ai/provider.server.ts) --------------------------------
# SECRET. Google AI Studio key; selects the Gemini provider automatically.
GEMINI_API_KEY=
# Optional overrides:
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.8-flash

# Email (Resend) and SMS (Twilio) keys are NOT set here: they are secrets of
# the Supabase edge function send-service-request-emails.
